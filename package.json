{
  "name": "nomos-ts",
  "version": "0.1.0",
  "description": "TypeScript port of the NOMOS agent framework for building LLM-powered assistants",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "ai",
    "agent",
    "llm",
    "chatbot",
    "typescript",
    "workflow",
    "automation"
  ],
  "author": "NOMOS Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dowhiledev/nomos.git",
    "directory": "typescript"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "ai": "^4.0.0",
    "events": "^3.3.0",
    "express": "^5.1.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^1.3.24",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/google": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/openai": {
      "optional": true
    },
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    }
  }
}
